# Apache mod_rewrite rules for Single Page App (Next.js static export)
<IfModule mod_rewrite.c>
  RewriteEngine On
  
  # RewriteBase path: /_myfamilyassistant.ai/ or /
  # When served from subdirectory, use relative path resolution
  <IfModule mod_dir.c>
    DirectoryIndex index.html
  </IfModule>
  
  # Don't rewrite if request is for an actual file that exists
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]
  
  # Don't rewrite if request is for an actual directory that exists  
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
  
  # Rewrite all remaining requests to index.html for SPA routing
  RewriteRule ^ index.html [L]
</IfModule>



