# Apache mod_rewrite rules for Single Page App (Next.js static export)
<IfModule mod_rewrite.c>
  RewriteEngine On
  
  # Don't rewrite static asset paths
  RewriteCond %{REQUEST_URI} ^/_next/ [OR]
  RewriteCond %{REQUEST_URI} \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$ [OR]
  RewriteCond %{REQUEST_URI} ^/robots\.txt$ [OR]
  RewriteCond %{REQUEST_URI} ^/sitemap\.xml$
  RewriteRule ^ - [L]
  
  # For all other requests, serve index.html
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.html [L]
</IfModule>


