<IfModule mod_rewrite.c>
  RewriteEngine On
  
  # The following check allows files/directories through without rewriting
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
  
  # Default SPA routing: send everything else to index.html
  RewriteRule ^ index.html [L]
</IfModule>
