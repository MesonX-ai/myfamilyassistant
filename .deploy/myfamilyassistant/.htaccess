<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  
  # Don't rewrite requests for actual files or directories
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  
  # Don't rewrite the _next directory or public files (static assets)
  RewriteCond %{REQUEST_URI} !^/myfamilyassistant\.ai/_next/
  RewriteCond %{REQUEST_URI} !^/_next/
  
  # SPA routing: rewrite everything else to index.html
  RewriteRule ^(.*)$ index.html [L]
</IfModule>





