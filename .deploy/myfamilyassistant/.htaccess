<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /myfamilyassistant.ai/
  
  # SPA routing: only rewrite routes that don't correspond to files or directories
  # For any path, if a file/directory exists, serve it directly
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.html [QSA,L]
</IfModule>






